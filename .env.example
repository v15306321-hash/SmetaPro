# ---- Общие ----
# production | development
APP_ENV=development
# Публичный адрес сайта (используется в ссылках из бота и в Open Graph)
BASE_URL=http://localhost:8000
# Случайная длинная строка: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me

# ---- База данных ----
# Production: postgresql+psycopg://user:password@db:5432/furniture
DATABASE_URL=sqlite:///./storage/dev.db

# ---- Telegram ----
# Токен от @BotFather. Никогда не коммитить реальное значение.
BOT_TOKEN=
# Имя бота без @ (для ссылок t.me/<имя>)
BOT_USERNAME=FurnitureEstimateBot
# polling — отдельный процесс `python -m app.bot.runner` (локально, docker-compose)
# webhook — бот внутри веб-сервиса (Render и другие PaaS), отдельный процесс не нужен
BOT_MODE=polling
# Необязательно: секрет заголовка webhook (по умолчанию выводится из SECRET_KEY)
WEBHOOK_SECRET=
# Telegram ID супер-администраторов платформы через запятую
SUPERADMIN_TELEGRAM_IDS=

# ---- Файлы ----
STORAGE_DIR=./storage

# ---- CRYPTO PAY (данные будут предоставлены заказчиком отдельно) ----
CRYPTO_PAY_API_TOKEN=
CRYPTO_PAY_API_URL=https://pay.crypt.bot/api

# ---- Безопасность ----
# Время жизни веб-сессии, дней
SESSION_TTL_DAYS=30
# Только для локальной разработки: вход на сайт без Telegram по /auth/dev-login
DEV_LOGIN=false
# Telegram Login Widget на странице входа (требует /setdomain в @BotFather)
TELEGRAM_LOGIN_WIDGET=false

# ---- Контакты поддержки (показываются на сайте) ----
SUPPORT_TELEGRAM=
SUPPORT_PHONE=
SUPPORT_EMAIL=

# ---- docker compose ----
POSTGRES_PASSWORD=change-me
